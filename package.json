{
  "name": "playwright-e2e",
  "version": "1.0.0",
  "description": "Playwright E2E test automation for markolosic.github.io with Page Object Model",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc -p .",
    "test:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "docker:build": "docker build -t playwright-e2e .",
    "docker:test": "docker compose run --rm tests"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
